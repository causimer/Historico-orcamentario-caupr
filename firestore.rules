rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isMaster() {
      return isSignedIn() && myRole() == 'master';
    }

    // documento único, criado manualmente uma vez no console, com o campo masterEmail
    match /config/roles {
      allow read: if isSignedIn();
      allow write: if isMaster();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      // cada pessoa só pode criar o PRÓPRIO documento de papel, na primeira vez que loga
      allow create: if isSignedIn() && request.auth.uid == userId && (
        (request.resource.data.role == 'master' &&
          request.auth.token.email == get(/databases/$(database)/documents/config/roles).data.masterEmail)
        || request.resource.data.role == 'viewer'
      );
      allow update, delete: if isMaster();
    }

    match /snapshots/{date} {
      allow read: if isSignedIn();
      allow write: if isMaster();
    }

    // retrato detalhado por conta contábil (fonte única do sistema, alimentada
    // pelo upload do relatório bruto do SISCONT)
    match /snapshotsDetalhe/{date} {
      allow read: if isSignedIn();
      allow write: if isMaster();
    }

    match /config/categorias {
      allow read: if isSignedIn();
      allow write: if isMaster();
    }

    // apelidos de conta contábil (nomes amigáveis exibidos no lugar do código do SISCONT)
    match /config/apelidosContas {
      allow read: if isSignedIn();
      allow write: if isMaster();
    }

    // Módulos, documentação e payloads do laboratório são privados.
    // O UID fixa a conta existente; e-mail isolado não autoriza acesso.
    // Escritas administrativas usam IAM e não passam pelas regras do cliente.
    match /implantaLab/{asset} {
      allow get: if request.auth != null
        && request.auth.uid == 'CP27dQkMVdUAE8CROxgJnmnkyP92'
        && request.auth.token.email == 'bruno.simer@caupr.gov.br';
      allow list, write: if false;
    }
  }
}
